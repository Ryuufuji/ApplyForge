# --- Supabase (optionnel : sinon mode démo local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (optionnel : sinon moteur de règles local) ---
# "anthropic" | "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Scraping des offres ---
SCRAPER_USER_AGENT=ApplyForgeBot/1.0 (+https://applyforge.app)

# --- Pilote automatique (page /automatisation) ---
# Sans RESEND_API_KEY, le pilote n'envoie JAMAIS d'email : il remet un
# mailto prêt et l'indique dans le journal (mode « remise humaine »).
RESEND_API_KEY=
APPLY_FROM_EMAIL=ApplyForge <candidatures@ton-domaine.be>
